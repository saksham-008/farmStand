<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Products</title>
</head>
<body>
    <h1><%= category %> Products</h1>

    <ul>
        <% for(let product of products) { %>
            <li>
                <a href="/products/<%= product._id %>" style="text-decoration: none;"> <%= product.name %> </a>
            </li>
        <% } %>
    </ul>

    <button><a href="/products/new" style="text-decoration: none;">Add new product</a></button>

    <% if(category !== "All") { %>
        <button><a href="/products" style="text-decoration: none;">All Products</a></button>
    <% } %>
    
    </body>
</html>